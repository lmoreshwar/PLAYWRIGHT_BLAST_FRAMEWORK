{
    // ── Command-free B.L.A.S.T. → Copilot runs (best + safest) ──
    // Deliberately NO "chat.tools.global.autoApprove": we keep a human gate for anything
    // unexpected. Instead we auto-approve ONLY the specific commands an automation job needs,
    // and hard-block destructive ones. Unattended runs must capture locators headlessly
    // (terminal Playwright / @playwright/cli) and never use the interactive shared browser.
    "chat.tools.terminal.autoApprove": {
        "npx playwright test": true,
        "npx playwright": true,
        "npx ts-node": true,
        "npx tsc": true,
        "npm run lint": true,
        "npm run index": true,
        "npm run test": true,
        "playwright-cli": true,
        "node": true,
        "Add-Content": true,
        "Get-Content": true,
        "Set-Content": true,
        "%{": true,
        "/rm\\s+-rf|Remove-Item.*-Recurse|del\\s+\\/|git\\s+push|git\\s+reset\\s+--hard|Format-|Stop-Computer|shutdown/i": false
    }
}