# ═══════════════════════════════════════════════
# AI Native Playwright Framework — Environment Template
# Copy to .env.qa / .env.uat / .env.dev and fill in real values.
# .env.* files are gitignored — only this template is committed.
# ═══════════════════════════════════════════════

BASE_URL=https://www.saucedemo.com
TEST_ENV=qa
DEFAULT_TIMEOUT=30000
NAVIGATION_TIMEOUT=90000
LOG_LEVEL=INFO
RETRY_COUNT=2

# Sauce Labs Toggle (true = run on cloud, false = run locally)
RUN_ON_SAUCE=false

# Application Credentials (local dev only; CI pulls from a secrets store)
APP_USERNAME=your-app-username
APP_PASSWORD=your-app-password

# Sauce Labs Credentials / Endpoint
SAUCE_USERNAME=your-sauce-username
SAUCE_ACCESS_KEY=your-sauce-access-key
SAUCE_URL=@ondemand.us-west-1.saucelabs.com:443/wd/hub
